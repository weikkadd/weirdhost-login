# Bot-Hosting / Weirdhost 自动续期配置

# 邮箱（仅用于通知）
EMAIL=your@email.com

# Session Token（从浏览器 Cookie 获取）
SESSION_TOKEN=your_session_token_here

# 或者使用完整 Cookie
WEIRDHOST_COOKIE=remember_web_XXXXXXXXXXXXXXXX=YYYYYYYY;

# GitHub Token（用于自动更新 Secrets，可选）
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram 通知配置（可选）
TG_CHAT_ID=123456789
TG_BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# 代理配置（推荐配置日本/韩国代理）
IS_PROXY=true
PROXY_SERVER=socks5://127.0.0.1:1080

# 运行模式
HEADLESS=true
WEIRDHOST_URL=https://hub.weirdhost.xyz
